# Copy this file to .env and replace the development-only placeholders.
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://procurement:replace_with_a_local_password@localhost:5432/procurement
LOG_LEVEL=INFO
APP_CURRENCY=USD
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-side only. Never expose this value through Vite or browser environment variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30

# Deterministic cost-optimization thresholds and weights.
PRICE_VARIANCE_THRESHOLD_PERCENT=10
MIN_PRICE_OPPORTUNITY_SAVINGS=5000
MIN_BENCHMARK_SUPPLIERS=3
CONTRACT_LEAKAGE_MIN_SPEND=100000
CONSOLIDATION_MIN_SPEND=250000
CONSOLIDATION_MIN_SUPPLIERS=3
CONSOLIDATION_MIN_DISPERSION_PERCENT=15
SUPPLIER_PERFORMANCE_MIN_SPEND=250000
SUPPLIER_PERFORMANCE_SCORE_THRESHOLD=75
SUPPLIER_SCORE_PRICE_WEIGHT=0.40
SUPPLIER_SCORE_QUALITY_WEIGHT=0.25
SUPPLIER_SCORE_DELIVERY_WEIGHT=0.20
SUPPLIER_SCORE_CONTRACT_WEIGHT=0.15
PRIORITY_IMPACT_WEIGHT=0.50
PRIORITY_CONFIDENCE_WEIGHT=0.30
PRIORITY_SEVERITY_WEIGHT=0.20
PRIORITY_HIGH_IMPACT_AMOUNT=1000000
